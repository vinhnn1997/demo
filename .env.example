# SQL Server used by local profile
MSSQL_SA_PASSWORD=123
DB_USERNAME=sa
DB_PASSWORD=123
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=tax_platform;encrypt=true;trustServerCertificate=true

# Spring and infrastructure
SPRING_PROFILES_ACTIVE=dev
EUREKA_SERVER_URL=http://localhost:8761/eureka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/tax-platform
KEYCLOAK_AUDIENCE=tax-api
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_CLIENT_ID=tax-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-service-account-secret
KEYCLOAK_MANAGED_ROLES=tax-officer,supervisor
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-a-random-local-secret
REDIS_SSL_ENABLED=false
TOKEN_REVOCATION_TTL=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000
