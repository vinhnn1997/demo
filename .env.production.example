# Copy this file to .env.production on the deployment server.
SPRING_PROFILES_ACTIVE=prod
MSSQL_SA_PASSWORD=replace-with-a-strong-password
DB_USERNAME=sa
DB_PASSWORD=replace-with-a-strong-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password
KEYCLOAK_AUDIENCE=tax-api
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Optional overrides:
# IMAGE_REPOSITORY=ghcr.io/your-org/tax-platform
# IMAGE_TAG=latest
# GATEWAY_PORT=8088
# EUREKA_PORT=8761
# KEYCLOAK_PORT=8080
