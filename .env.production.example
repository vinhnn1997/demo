# Copy this file to .env.production on the deployment server.
SPRING_PROFILES_ACTIVE=prod
MSSQL_SA_PASSWORD=replace-with-a-strong-password
DB_USERNAME=sa
DB_PASSWORD=replace-with-a-strong-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password
KEYCLOAK_AUDIENCE=tax-api
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_ADMIN_CLIENT_ID=tax-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-service-account-secret
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-a-strong-redis-password
DATAPLATFORM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Optional overrides:
# IMAGE_REPOSITORY=ghcr.io/your-org/tax-platform
# IMAGE_TAG=latest
# GATEWAY_PORT=8088
# EUREKA_PORT=8761
# KEYCLOAK_PORT=8080
